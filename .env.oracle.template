# Al Zait Oracle Cloud Configuration
# Copy this to .env and fill in your actual API keys

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI APIs
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# News API
NEWSAPI_KEY=your_newsapi_key_here

# Oracle Cloud Settings (DO NOT CHANGE)
ORACLE_CLOUD=true
ML_ENABLED=true
VECTOR_DB_ENABLED=true
ADVANCED_AUDIO_ENABLED=true

# System Configuration
LOG_LEVEL=INFO
PORT=8080
SCHEDULE_MINUTE=0
ORACLE_MODE=both

# ML Model Settings
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=/app/data/vector_db
AUDIO_OUTPUT_PATH=/app/data/audio

# Performance Tuning for 24GB RAM
PYTHONUNBUFFERED=1
PYTHONPATH=/app/src
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
