# Google Cloud Platform Configuration for Al Zait News Agent
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Telegram Bot Configuration (REQUIRED)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI/LLM API Keys (At least one is REQUIRED)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# News API Key (REQUIRED)
NEWSAPI_KEY=your_newsapi_key_here

# =============================================================================
# GOOGLE CLOUD PLATFORM SETTINGS
# =============================================================================

# Platform identification
GOOGLE_CLOUD=true
GCP_CLOUD_RUN=true

# Feature flags for full system
ML_ENABLED=true
VECTOR_DB_ENABLED=true
ADVANCED_AUDIO_ENABLED=true

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Logging
LOG_LEVEL=INFO

# Scheduling (minute of the hour to run collection)
SCHEDULE_MINUTE=0

# GCP deployment mode: "agents" | "bot" | "both"
GCP_MODE=both

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Python optimization
PYTHONUNBUFFERED=1
PYTHONPATH=/app/src

# Threading optimization for Cloud Run
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Model caching
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=/app/data/vector_db
AUDIO_OUTPUT_PATH=/app/data/audio

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Local LLM Configuration (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Advanced search queries (comma-separated)
SEARCH_QUERIES_AR=أخبار السودان اليوم,السياسة السودانية,الاقتصاد السوداني
SEARCH_QUERIES_EN=Sudan news today,Sudan political news,Sudan economy news

# RSS feeds (comma-separated)
RSS_FEEDS=https://www.aljazeera.com/xml/rss/all.xml,https://feeds.bbci.co.uk/arabic/rss.xml,http://www.sudantribune.com/spip.php?page=backend

# Agent behavior
MAX_ARTICLES_PER_QUERY=10
SUMMARY_LENGTH_SENTENCES=3
MAX_CONTENT_LENGTH=800

# Database
DATABASE_PATH=data/news.db

# =============================================================================
# HOW TO GET API KEYS
# =============================================================================

# 1. Telegram Bot Token:
#    - Message @BotFather on Telegram
#    - Create new bot: /newbot
#    - Copy the token

# 2. Telegram Chat ID:
#    - Message @userinfobot on Telegram
#    - Copy your Chat ID

# 3. Groq API Key (FREE):
#    - Visit: https://console.groq.com/
#    - Sign up and get free API key
#    - Fast inference for Llama models

# 4. Gemini API Key (FREE):
#    - Visit: https://makersuite.google.com/
#    - Get free Gemini Pro API key
#    - Google's advanced AI model

# 5. NewsAPI Key (FREE):
#    - Visit: https://newsapi.org/
#    - Register for free account
#    - Get API key (500 requests/day free)

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================

# For Google Cloud Run deployment:
# 1. Don't commit this file with real values
# 2. Use Google Secret Manager for production secrets
# 3. Set secrets via: gcloud secrets create SECRET_NAME --data-file=-
# 4. The cloud-run.yaml file references these secrets

# For local development:
# 1. Copy this to .env
# 2. Fill in your API keys
# 3. Run: python start-gcp.py
